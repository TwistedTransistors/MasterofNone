HOST=0.0.0.0
PORT=1337

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# Comma-separated list of sites allowed to read the API (your theme's URL).
CORS_ORIGIN=*

# Seed sample authors, topics, articles and images on first start (true/false).
SEED_ON_START=true

# Database (SQLite by default). For Postgres:
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname
